# Marketing-site analytics (this site ONLY — never the LOAM app). Set these in the Vercel project's
# Environment Variables so they're inlined into the build. With no key set (e.g. local dev), analytics
# is a complete no-op.
#
# Your PostHog project API key (starts with `phc_`).
VITE_POSTHOG_KEY=
# EU ingest host by default. Only override if your PostHog project lives in a different region.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
