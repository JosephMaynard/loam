{
  "name": "loam",
  "private": true,
  "version": "0.6.0",
  "description": "Local-first, off-grid messaging: a host runs it on a laptop, Pi, or phone; nearby people scan a QR and chat over the local network.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r --if-present build",
    "build:cli": "node scripts/build-cli.mjs",
    "smoke:cli": "node scripts/cli-smoke.mjs",
    "apk": "pnpm --filter app apk",
    "test": "pnpm -r --if-present test && pnpm run test:scripts",
    "test:scripts": "node --test 'scripts/*.test.mjs' 'cli/test/*.test.mjs'"
  },
  "devDependencies": {
    "@loam/qr": "workspace:*",
    "@loam/tui": "workspace:*",
    "esbuild": "catalog:",
    "tsx": "catalog:"
  },
  "keywords": [],
  "author": "Magic Zebra Ltd",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "tar@<7.5.21": "^7.5.21",
      "uuid@<11.1.1": "^11.1.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "ip-address@<10.7.1": "^10.7.2",
      "@xmldom/xmldom@^0.9.0": "^0.9.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "http-cache-semantics@<4.3.0": "^4.3.0"
    },
    "patchedDependencies": {
      "llama.rn@0.12.6": "patches/llama.rn@0.12.6.patch"
    }
  }
}
